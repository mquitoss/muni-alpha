{
  "name": "munialpha-static-map",
  "version": "0.4.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "submodules:init": "git submodule update --init --recursive",
    "prebuild": "npm run submodules:init",
    "build": "node scripts/build_static_site.js",
    "build:data": "uv run python scripts/build_map_data.py",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "preview": "wrangler dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:parity": "vitest run tests/frontend/parity.test.js",
    "tesela:check": "node scripts/verify_tesela.js",
    "baseline:check": "node scripts/parity_baseline.js --check",
    "baseline:write": "node scripts/parity_baseline.js --write",
    "lint": "eslint app.config.js playwright.config.js scripts src tests/frontend tests/e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "tesela": {
    "version": "0.3.0",
    "tag": "v0.3.0",
    "commit": "824caa0fb73b5bd540468c12452eadeda2d5bd04"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.25.0"
  }
}
